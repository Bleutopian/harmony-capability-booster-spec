{
  "name": "harmony-capability-booster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first toolchain for enhancing existing features with HarmonyOS capabilities",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "hcb": "node packages/hcb-cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
